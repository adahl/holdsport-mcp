#!/usr/bin/env bun
/**
 * holdsport-mcp — an MCP server over the Holdsport API.
 *
 * Exposes the same commands as the `holdsport` CLI as MCP tools so they can
 * be driven from Claude Cowork (or any MCP host). It shares the data + business
 * logic in ../src/client.ts with the CLI; the only thing here is tool wiring.
 *
 * Every tool maps to a specific operation, and there is no raw request/path
 * escape hatch. All tools are reads except three deliberate writes:
 * `create_activity`, `update_activity` and `respond_to_activity`, each gated
 * on an explicit `confirm: true` so an agent has to surface the details to its
 * user before writing. The chat/email tools are GraphQL reads only — `SignIn`
 * mints an auth token but writes no data, and no generic GraphQL tool is
 * exposed.
 *
 * One endpoint is not fixed in advance: `respond_to_activity` takes its path
 * and HTTP method from the activity's own `actions`, because they genuinely
 * vary. The client refuses to supply either if the server omits it, and
 * refuses to send credentials to any host but api.holdsport.dk — so the set of
 * reachable endpoints is still bounded, just not by this file alone.
 *
 * Credentials are passed on every tool call: each tool takes `username` and
 * `password` (and optional `team_id` / `base_url`) in its arguments, and a fresh
 * client is built per call. The server itself takes no startup arguments and
 * holds no credentials — the MCP host supplies them with each invocation. (Chat
 * access tokens minted via SignIn are cached in-process, keyed by login, so
 * repeat chat calls in a session skip re-authenticating; see clearChatTokenCache.)
 */

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";

import {
  HoldsportClient,
  REGISTRATION_TYPES,
  type RegistrationType,
} from "../src/client.ts";

const server = new McpServer({ name: "holdsport", version: "1.0.0" });

/** Credential fields every tool accepts. */
const auth = {
  username: z
    .string()
    .describe("Holdsport login username (not email / member number)"),
  password: z.string().describe("Holdsport password"),
};

const teamId = z
  .string()
  .optional()
  .describe("Team id (required for team-scoped data)");

/**
 * A calendar date the tools can trust.
 *
 * These arguments come from a model, not a person, and dates are compared as
 * strings downstream — an unpadded "2026-6-30" would silently never match, so
 * the window would never close and the call would page to its limit returning
 * activities well outside the range.
 */
// A factory rather than a shared instance: reusing one zod object makes the
// generated JSON Schema emit a `$ref` for the second use, and not every MCP
// client resolves those.
const isoDate = (description: string) =>
  z
    .string()
    .regex(/^\d{4}-\d{2}-\d{2}$/, "must be YYYY-MM-DD")
    .optional()
    .describe(description);

/** A page budget that cannot be zero, negative or fractional. */
const maxPages = () =>
  z
    .number()
    .int()
    .min(1)
    .max(50)
    .optional()
    .describe("Safety cap on pages fetched (default: 12)");

const registrationType = z
  .enum(
    Object.keys(REGISTRATION_TYPES) as [RegistrationType, ...RegistrationType[]],
  )
  .optional()
  .describe(
    "Sign-up mode (Tilmeldingstype): normal (members sign up themselves; the " +
      "server's default for new activities), pick_out (coach picks the squad), " +
      "available (members mark availability), everybody_attending (everyone is " +
      "signed up by default), pick_out_sub_teams, no_registration (no sign-up)",
  );

type Auth = {
  username: string;
  password: string;
  team_id?: string;
};

/** Build a per-call client from the credentials supplied in a tool's arguments. */
function clientFor(a: Auth): HoldsportClient {
  return new HoldsportClient({
    username: a.username,
    password: a.password,
    teamId: a.team_id,
  });
}

/** Serialize tool output as pretty JSON text content. */
function ok(data: unknown) {
  return {
    content: [{ type: "text" as const, text: JSON.stringify(data, null, 2) }],
  };
}

/** Surface a thrown error as a tool error rather than crashing the server. */
function toolError(err: unknown) {
  return {
    content: [
      {
        type: "text" as const,
        text: `Error: ${err instanceof Error ? err.message : String(err)}`,
      },
    ],
    isError: true,
  };
}

/**
 * Register a tool whose handler returns plain data; wraps it so the result is
 * serialized and any throw becomes an `isError` result. Every tool's input
 * schema carries the credential fields, so the handler always receives them.
 */
function tool<Extra extends z.ZodRawShape>(
  name: string,
  config: { title: string; description: string; inputSchema?: Extra },
  run: (
    client: HoldsportClient,
    args: z.infer<z.ZodObject<Extra & typeof auth>>,
  ) => Promise<unknown>,
): void {
  const inputSchema = { ...auth, ...(config.inputSchema ?? ({} as Extra)) };
  server.registerTool(
    name,
    { title: config.title, description: config.description, inputSchema },
    async (args: z.infer<z.ZodObject<Extra & typeof auth>>) => {
      try {
        return ok(await run(clientFor(args), args));
      } catch (err) {
        return toolError(err);
      }
    },
  );
}

tool(
  "teams",
  { title: "List teams", description: "List the teams you belong to." },
  (client) => client.listTeams(),
);

tool(
  "members",
  {
    title: "List members",
    description: "List a team's members (full raw member records).",
    inputSchema: { team_id: teamId },
  },
  (client, a) => client.listMembers(a.team_id),
);

tool(
  "member",
  {
    title: "Get member",
    description: "Show a single member by id.",
    inputSchema: {
      member_id: z.string().describe("Member id"),
      team_id: teamId,
    },
  },
  (client, a) => client.getMember(a.member_id, a.team_id),
);

tool(
  "roster",
  {
    title: "Team roster",
    description:
      "Contact list shaped for humans: name, role, birthday, mobile, email, member number.",
    inputSchema: {
      team_id: teamId,
      players: z.boolean().optional().describe("Only players (role 1)"),
      staff: z.boolean().optional().describe("Only staff (role 2)"),
    },
  },
  (client, a) => client.roster(a.team_id, { players: a.players, staff: a.staff }),
);

tool(
  "notes",
  {
    title: "List notes",
    description: "List a team's notes.",
    inputSchema: { team_id: teamId },
  },
  (client, a) => client.listNotes(a.team_id),
);

// Activities run over GraphQL (login-username auth). The detail folds in what
// used to be separate attendees + headcount tools.
tool(
  "activities",
  {
    title: "List activities",
    description:
      "List a team's upcoming activities, from `date` (YYYY-MM-DD, default today) onward, " +
      "one page at a time: event type, place, and sign-up count per activity. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      team_id: teamId,
      date: isoDate("Start date YYYY-MM-DD (default: today)"),
      page: z.number().optional().describe("Page number (default: 1)"),
    },
  },
  (client, a) =>
    client.listActivities({ teamId: a.team_id, date: a.date, page: a.page }),
);

tool(
  "activities_in_range",
  {
    title: "Activities in a date window",
    description:
      "A team's activities between `from` and `to` (YYYY-MM-DD, inclusive), paging as " +
      "needed. The API filters by start date only, so the far edge is applied here; " +
      "days are compared in the team's timezone. `username` must be the login username.",
    inputSchema: {
      team_id: teamId,
      from: isoDate("First day YYYY-MM-DD (default: today)"),
      to: isoDate("Last day YYYY-MM-DD (default: no limit)"),
      max_pages: maxPages(),
    },
  },
  (client, a) =>
    client.activitiesInRange({
      teamId: a.team_id,
      from: a.from,
      to: a.to,
      maxPages: a.max_pages,
    }),
);
tool(
  "my_attendance",
  {
    title: "Your own sign-up per activity",
    description:
      "Whether you are signed up for each of a team's activities in a date window, keyed " +
      "by activity id. Read from your own attendance row rather than the activity's " +
      "top-level status field, which disagrees with it on teams that register everyone " +
      "by default. `can_respond` is false once registration has closed. `offers` lists " +
      "the answers the activity accepts, by the server's own names: not always Tilmeld " +
      "and Afmeld — where the coach picks the squad the positive answer is 'Til rådighed', " +
      "and once that is set only Afmeld remains. Offer the user those words, not Tilmeld.",
    inputSchema: {
      team_id: teamId,
      from: isoDate("First day YYYY-MM-DD (default: today)"),
      to: isoDate("Last day YYYY-MM-DD (default: no limit)"),
      max_pages: maxPages(),
    },
  },
  (client, a) =>
    client.myAttendance({
      teamId: a.team_id,
      from: a.from,
      to: a.to,
      maxPages: a.max_pages,
    }),
);
tool(
  "attendance_actions",
  {
    title: "Responses an activity accepts",
    description:
      "What Holdsport will accept for an activity right now. An empty list means " +
      "registration is closed. Read this before offering the user a choice.",
    inputSchema: { activity_id: z.string().describe("Activity id") },
  },
  (client, a) => client.attendanceActions(a.activity_id),
);

tool(
  "respond_to_activity",
  {
    title: "Answer an activity — WRITES",
    description:
      "Sign up for or withdraw from an activity. **This writes to Holdsport.** Show the " +
      "user which activity and which answer, and get their approval, before setting " +
      "`confirm: true`. The request is built from the activity's own allowed actions and " +
      "re-read immediately beforehand, so a closed registration fails rather than being " +
      "forced.",
    inputSchema: {
      activity_id: z.string().describe("Activity id"),
      response: z
        .enum(["attend", "decline"])
        .describe("attend = Tilmeld, decline = Afmeld"),
      confirm: z
        .boolean()
        .describe("Must be true to write. Ask the user first."),
    },
  },
  (client, a) => {
    if (a.confirm !== true) {
      throw new Error(
        "refusing to write: confirm must be true. Show the user the activity and " +
          "the answer, and get their approval first.",
      );
    }
    return client.respondToActivity(a.activity_id, a.response, { confirm: true });
  },
);
tool(
  "activity",
  {
    title: "Activity detail + attendance",
    description:
      "Show one activity with its full attendance breakdown: counts plus the named " +
      "attending / not-attending / no-answer lists. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      activity_id: z.string().describe("Activity id"),
    },
  },
  (client, a) => client.getActivity(a.activity_id),
);

tool(
  "event_types",
  {
    title: "List event types",
    description:
      "List a team's activity event types (id, name, color) — the valid `event_type_id` " +
      "values for create_activity. " +
      "`username` must be the login username, not the email.",
    inputSchema: { team_id: teamId },
  },
  (client, a) => client.listEventTypes(a.team_id),
);

tool(
  "create_activity",
  {
    title: "Create activity (WRITE)",
    description:
      "Create a new activity on a team's calendar. THIS IS THE ONE TOOL THAT WRITES to " +
      "Holdsport (production data, visible to the whole team). Show the user the exact " +
      "details and get their explicit approval first; only then call with `confirm: true`. " +
      "This tool offers no way to delete an activity afterwards. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      team_id: teamId,
      name: z.string().describe("Activity name"),
      date: z.string().describe("Start date, YYYY-MM-DD"),
      start_time: z.string().describe("Start time, HH:MM (24-hour, team-local time)"),
      end_time: z.string().optional().describe("End time, HH:MM"),
      end_date: z
        .string()
        .optional()
        .describe("End date, YYYY-MM-DD (only for multi-day activities)"),
      meeting_time: z
        .string()
        .optional()
        .describe("Meeting time (Mødetid), HH:MM"),
      place: z.string().optional().describe("Location"),
      comment: z.string().optional().describe("Description shown on the activity"),
      event_type_id: z
        .number()
        .optional()
        .describe("Event type id (see the event_types tool)"),
      max_attendees: z.number().optional().describe("Max number of attendees"),
      registration_type: registrationType,
      confirm: z
        .boolean()
        .describe(
          "Must be true. Set only after the user has explicitly approved creating " +
            "exactly this activity.",
        ),
    },
  },
  (client, a) => {
    if (a.confirm !== true) {
      throw new Error(
        "not created: confirm must be true — show the user the activity details " +
          "and get their approval first",
      );
    }
    return client.createActivity(
      {
        name: a.name,
        date: a.date,
        start_time: a.start_time,
        end_time: a.end_time,
        end_date: a.end_date,
        meeting_time: a.meeting_time,
        place: a.place,
        comment: a.comment,
        event_type_id: a.event_type_id,
        max_attendees: a.max_attendees,
        registration_type: a.registration_type,
      },
      a.team_id,
    );
  },
);

tool(
  "update_activity",
  {
    title: "Edit activity (WRITE)",
    description:
      "Edit an existing activity. THIS WRITES to Holdsport (production data, visible to " +
      "the whole team). Pass only the fields to change — everything else keeps its value. " +
      "Read the activity first (the `activity` tool), show the user exactly what will " +
      "change, and get their explicit approval; only then call with `confirm: true`. " +
      "For an activity in a repeating series, only that occurrence is changed — this " +
      "tool never touches the rest of the series (use the Holdsport app for that). " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      activity_id: z.string().describe("Activity id"),
      name: z.string().optional().describe("New activity name"),
      date: z.string().optional().describe("New start date, YYYY-MM-DD"),
      start_time: z
        .string()
        .optional()
        .describe("New start time, HH:MM (24-hour, team-local time)"),
      end_time: z.string().optional().describe("New end time, HH:MM"),
      end_date: z
        .string()
        .optional()
        .describe("New end date, YYYY-MM-DD (only for multi-day activities)"),
      meeting_time: z
        .string()
        .optional()
        .describe("New meeting time (Mødetid), HH:MM"),
      place: z.string().optional().describe("New location"),
      comment: z.string().optional().describe("New description shown on the activity"),
      event_type_id: z
        .number()
        .optional()
        .describe("New event type id (see the event_types tool)"),
      max_attendees: z.number().optional().describe("New max number of attendees"),
      registration_type: registrationType,
      confirm: z
        .boolean()
        .describe(
          "Must be true. Set only after the user has explicitly approved exactly " +
            "these changes.",
        ),
    },
  },
  (client, a) => {
    if (a.confirm !== true) {
      throw new Error(
        "not updated: confirm must be true — show the user what will change " +
          "and get their approval first",
      );
    }
    return client.updateActivity(
      a.activity_id,
      {
        name: a.name,
        date: a.date,
        start_time: a.start_time,
        end_time: a.end_time,
        end_date: a.end_date,
        meeting_time: a.meeting_time,
        place: a.place,
        comment: a.comment,
        event_type_id: a.event_type_id,
        max_attendees: a.max_attendees,
        registration_type: a.registration_type,
      },
      // Hardcoded to this one occurrence: an agent can never edit a whole
      // series through this tool, whatever it passes.
      { repeatScope: "this" },
    );
  },
);

tool(
  "tasks",
  {
    title: "List tasks",
    description: "List an activity's tasks.",
    inputSchema: { activity_id: z.string().describe("Activity id") },
  },
  (client, a) => client.listTasks(a.activity_id),
);

tool(
  "user",
  { title: "Current user", description: "Show the current user profile." },
  (client) => client.getUser(),
);

tool(
  "profiles",
  { title: "List profiles", description: "List managed profiles." },
  (client) => client.listProfiles(),
);

/**
 * Note: the GraphQL tools (chat + email) authenticate with the *login username*
 * (not email / member number), which may differ from the REST `username` — pass
 * the login username as `username` for these tools.
 */
tool(
  "chats",
  {
    title: "List chat rooms",
    description:
      "List your chat rooms (GraphQL), each with unread count and a last-message preview. " +
      "`username` must be the login username, not the email.",
  },
  (client) => client.listChatRooms(),
);

tool(
  "chat",
  {
    title: "Read chat room",
    description:
      "Show a chat room's messages (GraphQL), oldest first. `limit` keeps only the most recent N. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      room_id: z.string().describe("Chat room id"),
      limit: z
        .number()
        .optional()
        .describe("Only the most recent N messages"),
    },
  },
  (client, a) => client.chatRoom(a.room_id, a.limit),
);

tool(
  "emails",
  {
    title: "List emails",
    description:
      "List your email inbox (GraphQL), most recent first: subject, sender, date, read state. " +
      "`sent: true` lists the sent box; `limit` keeps only the most recent N. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      sent: z.boolean().optional().describe("List the sent box instead of the inbox"),
      limit: z.number().optional().describe("Only the most recent N emails"),
    },
  },
  (client, a) => client.listEmails({ sent: a.sent, limit: a.limit }),
);

tool(
  "email",
  {
    title: "Read email",
    description:
      "Show a single email (GraphQL): subject, sender, recipients, body, and attachments. " +
      "`username` must be the login username, not the email.",
    inputSchema: {
      email_id: z.string().describe("Email id"),
    },
  },
  (client, a) => client.getEmail(a.email_id),
);

await server.connect(new StdioServerTransport());
